<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="commission_payment_form_view" model="ir.ui.view">
            <field name="name">commission.payment.view.form</field>
            <field name="model">commission.payment</field>
            <field name="arch" type="xml">
                <form create="0">
                    <group>
                        <field name="agent_id"/>
                    </group>
                    <field name="commission_ids" nolabel="1">
                        <tree>
                            <field name="agent_id" />
                            <field name="date" />
                            <field name="amount" />
                            <field name="state" />
                        </tree>
                    </field>
                    <footer>
                        <button type="object" name="confirm_payment" string="Payment" class="oe_highlight"/>
                        OR
                        <button string="Cancel" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <record id="commission_payment_action" model="ir.actions.act_window">
            <field name="name">Agent Commission</field>
            <field name="res_model">commission.payment</field>
            <field name='view_mode'>form</field>
            <field name='target'>new</field>
        </record>

        <!-- Menus -->
        <menuitem
            id="commission_payment_sub_menu"
            name="Commission Payment"
            parent="agent_commission.agent_commission_root"
            action="commission_payment_action"
            sequence="2"/>

    </data>
</odoo>