<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="commission_payment_report_wizard" model="ir.ui.view">
            <field name="name">agent.commission.payment.form</field>
            <field name="model">agent.commission.payment</field>
            <field name="arch" type="xml">
                <form string="Commission Payment Report">
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="agent_ids" widget="many2many_tags"/>
                            <field name="state"/>
                        </group>
                        <footer>
                            <button string="Print" name="print_report" type="object" class="oe_highlight"/>
                            or
                            <button string="Cancel" class="btn-default" special="cancel"/>
                        </footer>
                    </group>
                </form>
            </field>
        </record>

        <record id="commission_payment_report_action" model="ir.actions.act_window">
            <field name="name">Commission Payment Report</field>
            <field name="res_model">agent.commission.payment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_report" name="Commission Report" parent="agent_commission.agent_commission_root"
                  action="commission_payment_report_action" sequence="3"/>

    </data>
</odoo>
